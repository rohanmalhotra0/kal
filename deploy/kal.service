# systemd unit for kal. deploy/install.sh copies this to /etc/systemd/system/.
# Code: /opt/kal. Python: /opt/kal-venv. State: /var/lib/kal. Settings: /etc/kal/kal.env.
[Unit]
Description=kal Kalshi trading bot (dashboard + scheduler)
After=network-online.target time-sync.target
Wants=network-online.target
# Never give up restarting it.
StartLimitIntervalSec=0

[Service]
Type=simple
User=kal
Group=kal
WorkingDirectory=/opt/kal
Environment=KAL_HOME=/var/lib/kal
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/kal/kal.env
# 127.0.0.1 only: reach the dashboard with ssh -L 8787:localhost:8787
ExecStart=/opt/kal-venv/bin/python -m kal app --host 127.0.0.1 --port 8787
# If it stops for any reason, start it again 5 seconds later. Every time.
# If it keeps crashing, wait longer each time, up to 5 minutes (systemd 254+).
Restart=always
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=300
# On stop, a trade run in progress gets up to 5 minutes to finish its basket.
KillSignal=SIGTERM
TimeoutStopSec=330

# Cap kal's memory, so it can never starve SSH or the system: 60% of the server's RAM
# (1.2 GB of 2 GB). A trade run peaks near 320 MB and research near 220 MB, and they run at
# the same time (install-check measures it, with no swap). Past the cap the kernel stops one
# process. Research runs in its own process and asks to go first; OOMPolicy=continue keeps
# the rest (trading) running. If the main process is the one stopped, it starts again.
MemoryMax=60%
OOMPolicy=continue

# Lock it down: it only needs to write its own state folder.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kal
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# A blocked call fails instead of killing the process (which could cut a basket in half).
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
